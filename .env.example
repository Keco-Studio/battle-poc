# Legacy Supabase integration is disabled in local Web mode.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── App ports (defaults in package.json) ──
# battle-poc: 3002 | keco-studio: 3000 | keco-simulation: 3001

# ── Battle LLM / AI proxy (`npm run dev:ai`, configure server/.env) ──
# NEXT_PUBLIC_BATTLE_DECISION_MODE=dual_llm
# NEXT_PUBLIC_BATTLE_LLM_PROVIDER=minimax
# NEXT_PUBLIC_BATTLE_LLM_MODEL=MiniMax-M2.7
# BATTLE_AI_SERVER_URL=http://127.0.0.1:8787
# NEXT_PUBLIC_BATTLE_AI_SERVER_URL=http://localhost:8787
# NEXT_PUBLIC_BATTLE_LLM_TIMEOUT_MS=60000

# ── Playwright e2e (optional) ──
# PLAYWRIGHT_AUTH_EMAIL=
# PLAYWRIGHT_AUTH_PASSWORD=
# PLAYWRIGHT_SUPABASE_SERVICE_ROLE_KEY=  # legacy remote suites only
